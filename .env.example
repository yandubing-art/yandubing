# Lark 自建应用
PREVIEW_MODE=false
LARK_APP_ID=cli_replace_me
LARK_APP_SECRET=replace-me

# 当前多维表格
BITABLE_APP_TOKEN=replace-with-dispatch-base-token
BITABLE_TABLE_ID=tbl_replace_with_dispatch_table

# 门店资料表：起点与目的地使用此表中的门店名称作为固定选项。
STORE_BITABLE_APP_TOKEN=replace-with-store-base-token
STORE_TABLE_ID=tbl_replace_with_store_table
STORE_NAME_FIELDS=Single Option,门店名称,门店,Store Name,Store,名称,Name

# 车辆档案表。推荐直接填写表 ID（多个表用逗号分隔），避免依赖表名扫描。
# 留空时按 VEHICLE_TABLE_NAMES 自动发现。
VEHICLE_TABLE_IDS=tbl_replace_with_company_vehicles,tbl_replace_with_store_vehicles
VEHICLE_TABLE_NAMES=Company Vehicle,Stores Vehicle
VEHICLE_INACTIVE_KEYWORDS=sold,已售,under maintenance,out of service,报废,维修中,停用
VEHICLE_PLATE_FIELDS=Number Plate | 车牌号码,Number Plate,车牌号码,车牌
VEHICLE_BRAND_FIELDS=Vehicle Brand | 车辆品牌,Vehicle Brand,车辆品牌,品牌
VEHICLE_MODEL_FIELDS=Model | 车型,车型描述,车型,车辆型号,Vehicle Model,Model Description,Model
VEHICLE_TYPE_FIELDS=Vehicle Type | 车辆类型,Vehicle Type,车辆类型
VEHICLE_STATUS_FIELDS=Vehicle Status | 车辆状态,Vehicle Status,车辆状态
VEHICLE_OWNER_FIELDS=Store | 所属门店,Department | 所属部门,所属门店,所属部门
VEHICLE_YEAR_FIELDS=Year | 年份,Year,年份
VEHICLE_PHOTO_FIELDS=Vehicle Photo | 车辆照片,车辆照片,车辆图片,Vehicle Photo,Photo,照片
VEHICLE_MILEAGE_FIELDS=Maintenance mileage,当前公里数,当前里程,Mileage
VEHICLE_NEXT_MAINTENANCE_FIELDS=Next Service Due | 下次保养里程,Next Service Due,下次保养里程,下次保养公里数
VEHICLE_REGISTERING_AUTHORITY_FIELDS=Registering authority | 注册地点,Registering authority,注册地点
VEHICLE_LAST_SERVICE_DATE_FIELDS=Last Service Date | 上次保养日期,Last Service Date,上次保养日期
VEHICLE_SERVICE_PROVIDER_FIELDS=Service Provider | 服务提供商,Service Provider,服务提供商
VEHICLE_SPARE_KEY_FIELDS=Spare Key | 备用钥匙,Spare Key,备用钥匙
VEHICLE_REGISTER_NUMBER_FIELDS=Register number | 注册号,Register number,注册号
VEHICLE_IDENTIFICATION_NUMBER_FIELDS=Vehicle identification number | 车辆ID,Vehicle identification number,车辆ID
VEHICLE_CERTIFICATE_EXPIRY_FIELDS=Certificate Expiry | 证书有效期,Certificate Expiry,证书有效期
VEHICLE_POLICY_NUMBER_FIELDS=Policy Number | 保单号,Policy Number,保单号
VEHICLE_INSURANCE_FIELDS=Insurance,保险
VEHICLE_FLEET_CARD_PHOTO_FIELDS=Fuel card picture | 加油油卡图片,Fuel card picture | 加油卡图片,Fuel card picture,加油油卡图片,加油卡图片,Fleet card picture,车队卡照片,车卡照片
VEHICLE_FNB_FLEET_CARD_FIELDS=Fuel Card | 加油油卡号,Fuel Card | 加油卡号,Fuel Card,加油油卡号,加油卡号,FNB Fleet Card,FNB车队卡,FNB 车队卡

# 通讯录根部门 ID；0 表示全员通讯录根部门
LARK_CONTACT_ROOT_DEPARTMENT_ID=0
# 后端自身接口鉴权；请换成随机长字符串
INTERNAL_API_TOKEN=replace-with-a-long-random-token

# 登录与账号权限
# 生产环境首次启动时必须配置一个独立管理员账号，后续可在“账号管理”中调整角色。
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin.dispatch
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_STORE_PATH=./data/auth.json
# Base 管理员一次性授权后的加密令牌；不要将该文件放入版本控制。
LARK_PHOTO_SYNC_STORE_PATH=./data/lark-photo-sync.json
NOTIFICATION_SETTINGS_PATH=./data/notification-settings.json
# 车辆保养确认、保修单据和车辆档案图的本地审计目录。
VEHICLE_ASSETS_STORE_PATH=./data/vehicle-assets.json
VEHICLE_ASSETS_DIRECTORY=./data/vehicle-assets
AUTH_SESSION_TTL_SECONDS=43200

# Tracker 车辆列表报告自动同步。同步 worker 不开放网络端口；账号密码只保存在
# 生产服务器环境变量中，不要提交到版本控制。
TRACKER_SYNC_ENABLED=false
TRACKER_USERNAME=
TRACKER_PASSWORD=
TRACKER_BASE_URL=https://app.tracker.co.za
TRACKER_STATUS_PATH=./data/tracker-status.json
TRACKER_HISTORY_DIRECTORY=./data/tracker-history
TRACKER_HISTORY_RETENTION_DAYS=90
TRACKER_BROWSER_PROFILE_PATH=./data/tracker-browser-profile
TRACKER_DOWNLOAD_DIRECTORY=./data/tracker-downloads
# 留空时自动查找服务器上的 Microsoft Edge 或 Google Chrome。
TRACKER_BROWSER_EXECUTABLE_PATH=
# 若站点或出口网关拦截 HeadlessChrome，可配置为服务器当前 Edge 的正常 User-Agent。
TRACKER_BROWSER_USER_AGENT=
# 可选，仅故障排查时启用；页面可能包含车辆位置，因此默认不保存截图。
TRACKER_ERROR_SCREENSHOT_PATH=
TRACKER_HEADLESS=true
# 默认直接读取 Tracker 实时车辆列表。仅在需要刷新 VIN/里程且已确认下载稳定时启用 PDF 报表。
TRACKER_REPORT_DOWNLOAD_ENABLED=false
# 每日从 Tracker 报表邮箱读取 Trip Report (Detail) CSV。默认每天 02:00
# 首次检查；没有新文件时每 30 分钟重试，最晚检查到 06:00。Gmail 使用 OAuth2
# 连接 IMAP，不保存 Gmail 登录密码。授权范围必须包含 https://mail.google.com/。
TRACKER_REPORT_EMAIL_ENABLED=false
TRACKER_REPORT_EMAIL_AUTH_MODE=oauth2
TRACKER_REPORT_EMAIL_HOST=imap.gmail.com
TRACKER_REPORT_EMAIL_PORT=993
TRACKER_REPORT_EMAIL_USER=
TRACKER_REPORT_EMAIL_CLIENT_ID=
TRACKER_REPORT_EMAIL_CLIENT_SECRET=
TRACKER_REPORT_EMAIL_REFRESH_TOKEN=
TRACKER_REPORT_EMAIL_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
TRACKER_REPORT_EMAIL_MAILBOX=INBOX
TRACKER_REPORT_EMAIL_SUBJECT=Trip Report (Detail)
TRACKER_REPORT_EMAIL_DIRECTORY=./data/tracker-email-reports
TRACKER_REPORT_EMAIL_STATE_PATH=./data/tracker-email-report.json
TRACKER_REPORT_EMAIL_RUN_HOUR=2
TRACKER_REPORT_EMAIL_RUN_MINUTE=0
TRACKER_REPORT_EMAIL_LOOKBACK_DAYS=7
# 读取已下载的 Trip Report (Detail) 并按 Tracker/VIN/车牌更新车辆档案公里数。
# 只允许写入更高公里数；报表冲突、低于现值和无法唯一匹配的记录只记审计。
TRACKER_MILEAGE_SYNC_ENABLED=false
TRACKER_MILEAGE_SYNC_STATE_PATH=./data/tracker-mileage-sync.json
# 每 15 分钟读取一次；任何尝试后都至少冷却 15 分钟，避免高频访问 Tracker。
TRACKER_SYNC_INTERVAL_SECONDS=300
TRACKER_ACTIVE_SYNC_INTERVAL_SECONDS=300
TRACKER_MIN_SYNC_INTERVAL_SECONDS=300
TRACKER_RETRY_INTERVAL_SECONDS=120
TRACKER_PAGE_TIMEOUT_SECONDS=90
TRACKER_ACTIVE_STATUS_KEYWORDS=执行中,已出发,running,in progress
# 留空时读取 http://127.0.0.1:${PORT}/api/tasks 判断是否存在执行中任务。
TRACKER_ACTIVITY_URL=

# Lark OAuth（推荐）：把 LARK_OAUTH_REDIRECT_URI 配置为你的部署域名回调地址，
# 并在 Lark 自建应用「安全设置 > 重定向 URL」添加相同地址。
# 仅申请识别登录人所需的最小授权范围；例如可先留空 scope 并使用 user_info。
LARK_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/lark/callback
LARK_OAUTH_SCOPES=
# 车辆照片同步单独请求的用户授权范围。请在自建应用中开通用户身份
# drive:drive 和 base:record:update。
# offline_access 用于在服务器上安全刷新该管理员授权，避免每两小时重新连接。
LARK_PHOTO_SYNC_SCOPES=drive:drive base:record:update offline_access
# 新首次登录的 Lark 用户默认角色；管理员可在网页中修改。
LARK_DEFAULT_ROLE=dispatcher

# 服务配置
PORT=3000
POLL_INTERVAL_MS=60000
# 人员、车辆、门店选项缓存时间（秒）；默认 5 分钟
OPTIONS_CACHE_TTL_SECONDS=300
STORE_PATH=./data/dispatch.json

# 可选：真正执行调度的下游地址。
# 未配置时，后端只把任务推进到“已排程”，不会伪造执行成功。
DISPATCH_EXECUTOR_URL=
